PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Database Configuration
# Dual-database support: If DATABASE_URL is set, Zylix operates in PostgreSQL mode.
# If DATABASE_URL is empty, Zylix falls back to local SQLite at DB_PATH.
DATABASE_URL=postgresql://username:password@hostname:5432/zylix_db
PG_SSL=true

# SQLite fallback path
DB_PATH=./server/data/zylix.db
